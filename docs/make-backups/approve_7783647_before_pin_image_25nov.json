           }
          ],
          "language": "javascript",
          "inputFormat": "editor",
          "codeEditorJavascript": "const parseTarget = (row) => {\n  const target = row && row.__IMTTARGET__;\n  if (typeof target === \"string\") {\n    const parsed = {};\n    const pairPattern = /(?:\\[|\\{|,)\\s*(\\d+)\\s*:\\s*\"((?:\\\\.|[^\"\\\\])*)\"/g;\n    let match;\n    while ((match = pairPattern.exec(target))) {\n      try { parsed[match[1]] = JSON.parse(`\"${match[2]}\"`); } catch (error) { parsed[match[1]] = match[2]; }\n    }\n    return parsed;\n  }\n  if (target && typeof target === \"object\") return target;\n  return row;\n};\n\nconst isBlank = (v) => {\n  if (v === null || v === undefined) return true;\n  const s = String(v).trim();\n  return s === \"\" || s.toLowerCase() === \"null\" || s.toLowerCase() === \"undefined\";\n};\n\nconst gags = Array.isArray(input.gags) ? input.gags : [];\nconst registry = Array.isArray(input.registry) ? input.registry : [];\nconst gagId = String(input.gagId || \"\").trim();\n\n// Find the matching GAGS row and its actual sheet row number\nlet gagRow = null;\nlet sheetRow = null;\nfor (const raw of gags) {\n  const row = parseTarget(raw);\n  if (String(row[\"0\"] || \"\").trim() === gagId) {\n    gagRow = row;\n    sheetRow = row[\"20\"];\n    break;\n  }\n}\n\nif (!gagRow) {\n  return { allLive: false, sheetRow: null, gagId };\n}\n\n// Required product suffixes are whichever of T-SHIRT/LONG-SLEEVE/SWEATSHIRT/HOODIE/MUG\n// have a non-blank release date in GAGS columns 8-12.\nconst suffixes = [\n  { col: \"8\", suffix: \"T-SHIRT\" },\n  { col: \"9\", suffix: \"LONG-SLEEVE\" },\n  { col: \"10\", suffix: \"SWEATSHIRT\" },\n  { col: \"11\", suffix: \"HOODIE\" },\n  { col: \"12\", suffix: \"MUG\" }\n];\n\nconst requiredCodes = [];\nsuffixes.forEach((p) => {\n  if (!isBlank(gagRow[p.col])) requiredCodes.push(`${gagId}-${p.suffix}`);\n});\n\nif (requiredCodes.length === 0) {\n  return { allLive: false, sheetRow, gagId };\n}\n\n// Build a map of PRODUCT_CODE -> STATUS from the registry\nconst statusByCode = {};\nregistry.forEach((raw) => {\n  const row = parseTarget(raw);\n  const code = String(row[\"1\"] || \"\").trim();\n  if (code) statusByCode[code] = String(row[\"30\"] || \"\").trim();\n});\n\nconst allLive = requiredCodes.every((code) => statusByCode[code] === \"LIVE\");\n\nreturn { allLive, sheetRow, requiredCodes, gagId };"
         },

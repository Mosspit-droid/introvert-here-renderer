      "name": "need",
      "value": "{{1.result.maxPos}}"
     }
    ],
    "language": "javascript",
    "inputFormat": "editor",
    "codeEditorJavascript": "const checks = Array.isArray(input.checks) ? input.checks : []; let best = null;\nfor (const c of checks) if (c && c.status === \"success\" && Array.isArray(c.urls)) best = c;\nconst urls = (best && best.urls) || [];\nreturn { urls, complete: urls.length >= Number(input.need || 1), got: urls.length };"
   },
